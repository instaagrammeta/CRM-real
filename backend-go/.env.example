# ==============================
# CRM Real Estate Backend (Go)
# ==============================

# --- Server ---
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=crm
DB_PASSWORD=crm_password
DB_NAME=crm_real
DB_SSLMODE=disable

# --- JWT ---
JWT_SECRET=change-me-to-a-very-long-random-string
JWT_EXPIRE_HOURS=72

# --- Admin (auto-created on first run) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=nav-xona@2026
ADMIN_FULL_NAME=Главный Администратор

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# --- Telegram Bot (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEBUG=false

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
