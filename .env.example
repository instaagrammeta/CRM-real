# =====================================================================
# CRM Real Estate — root .env (used by docker-compose.yml)
# Copy to .env and adjust before running `docker compose up`.
# =====================================================================

# --- Database ---
DB_USER=crm
DB_PASSWORD=change_me_db_password
DB_NAME=crm_real

# --- Auth ---
# Generate a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=please-generate-a-long-random-secret-string
JWT_EXPIRE_HOURS=72

# --- Default admin (created on first boot) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_admin_password
ADMIN_FULL_NAME=Главный Администратор

# --- Backend ---
MAX_UPLOAD_MB=50
CORS_ORIGINS=*

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=

# --- Frontend (visible to browser) ---
# Same-host: leave default `/` so Nuxt calls go through Nginx.
PUBLIC_API_BASE=/
PUBLIC_WS_BASE=/

# --- Nginx public port ---
PUBLIC_HTTP_PORT=80
